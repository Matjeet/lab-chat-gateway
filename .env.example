# ---------------------------------------------------------------------------
#  Variables de entorno del microservicio chat-gateway
# ---------------------------------------------------------------------------
#  Uso:
#    cp .env.example .env      # y ajusta los valores para tu entorno
#
#  - `./gradlew bootRun` carga .env automáticamente (ver
#    com.arquetipo.demo.common.env.DotenvEnvironmentPostProcessor).
#  - Docker:  docker run --env-file .env chat-gateway
#  - Los tests NO usan .env (firebase.enabled=false en src/test/resources/application.yml,
#    con un VerificadorTokenIdentidad de prueba vía @MockitoBean).
#  - En producción/CI las variables las inyecta el entorno, no este fichero.
#
#  Todas tienen un valor por defecto en application.yml; aquí solo se sobreescriben.
# ---------------------------------------------------------------------------

# --- gRPC de los microservicios a los que el gateway enruta ---
REGISTRO_GRPC_HOST=localhost
REGISTRO_GRPC_PORT=9090
CONVERSACION_GRPC_HOST=localhost
CONVERSACION_GRPC_PORT=9091

# --- Firebase Auth (el gateway es el ÚNICO punto del sistema que valida tokens) ---
# Cualquier clave de cuenta de servicio del MISMO proyecto de Firebase que usa
# chat-registro para crear las cuentas sirve para verificar (no hace falta que sea el
# mismo fichero). El JSON NUNCA se versiona (ya gitignoreado, igual que este .env).
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- CORS (peticiones REST /api/**) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# --- WebSocket (/ws/**, independiente de CORS_ALLOWED_ORIGINS) ---
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
